# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database (On Render, use a cloud database like MongoDB Atlas Free Tier)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyuhox?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/vyuhox

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Client URL (For local dev: http://localhost:5173. On Render, leave empty or set your Render URL)
CLIENT_URL=http://localhost:5173

# Optional: AI Gateway Keys (If omitted, VYUHOX automatically uses its built-in Deep Semantic Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
